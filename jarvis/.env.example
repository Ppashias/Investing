# JARVIS configuration.
# Copy to `.env` at the repository root and fill in. `.env` is gitignored.
#
# Credentials may live here OR in the OS keychain (service name "jarvis").
# The environment is checked first, so a value here overrides the keychain.
# On Windows the keychain is Credential Manager, DPAPI-bound to your account —
# prefer it for anything long-lived.

# ── credentials ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Shared token the frontend presents to the API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_TOKEN=

# ── optional second provider ─────────────────────────────────────────────────
# OPENAI_API_KEY=
# Point at a local runtime instead (Ollama / llama.cpp / LM Studio / vLLM):
# JARVIS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# JARVIS_OPENAI_COMPAT_MODELS=["llama3.1"]

# ── server ───────────────────────────────────────────────────────────────────
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=console

# Set false only for local development without a token.
JARVIS_REQUIRE_AUTH=true

# ── model assignment per task class ──────────────────────────────────────────
JARVIS_MODEL_REASONING=claude-opus-5
JARVIS_MODEL_CONVERSATION=claude-sonnet-5
JARVIS_MODEL_FAST=claude-haiku-4-5

# ── Phase 2: memory and knowledge ────────────────────────────────────────────

# Embedding endpoint for semantic retrieval. Anything speaking /v1/embeddings:
# OpenAI, Ollama (http://localhost:11434/v1), LM Studio, llama.cpp, vLLM.
# Without one, retrieval is LEXICAL ONLY — it matches wording, not meaning.
# JARVIS reports which it is; it does not pretend.
# JARVIS_EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# JARVIS_EMBEDDING_MODEL=text-embedding-3-small
# JARVIS_EMBEDDING_DIM=1536

# ask  = propose memories and wait for yes/no (default)
# auto = store without asking
# off  = store only what you explicitly ask to be remembered
# JARVIS_MEMORY_CAPTURE_MODE=ask
# JARVIS_MEMORY_MAX_INJECTED=8

# Directories JARVIS may ingest documents from. Empty means none, which is the
# safe default for an endpoint that otherwise reads arbitrary files.
# Uploads through the UI work regardless.
# JARVIS_KNOWLEDGE_ROOTS=["/home/you/Documents/notes"]

# ── Phase 3: computer control ────────────────────────────────────────────────

# Master switch. Off does not hide the endpoints — they report why nothing
# works, which is more useful than a 404 when you are debugging a display.
# JARVIS_COMPUTER_ENABLED=true

# Display to drive. Unset uses DISPLAY from the environment.
# JARVIS_COMPUTER_DISPLAY=:0

# Create an Xvfb display when none exists. Opt-in on purpose: it means JARVIS
# can launch and drive GUI applications on a headless machine. The status
# endpoint and the Computer panel both label a virtual display as virtual —
# there is no physical screen behind it and JARVIS will not imply there is.
# JARVIS_COMPUTER_VIRTUAL_DISPLAY=false
# JARVIS_COMPUTER_VIRTUAL_WIDTH=1280
# JARVIS_COMPUTER_VIRTUAL_HEIGHT=800

# Directories JARVIS may touch. Empty means NO filesystem access and NO
# terminal access — commands are confined to these roots too, both by working
# directory and by argument, so an empty list is a working configuration and
# not a broken one.
# JARVIS_COMPUTER_FILE_ROOTS=["/home/you/projects/scratch"]

# Read is implied by a root. Write and delete are separate switches, off by
# default, because "look at my project" and "change my project" are different
# permissions.
# JARVIS_COMPUTER_WRITE_FILES=false
# JARVIS_COMPUTER_DELETE_FILES=false

# Working directory for commands. Defaults to the first file root.
# JARVIS_COMPUTER_WORKING_DIRECTORY=/home/you/projects/scratch

# Screenshots live in memory for this long and are never written to disk
# unless retention is switched on. A screenshot can contain a password
# manager, a bank balance, or somebody else's message — the default is
# observe-when-needed, not record-everything.
# JARVIS_COMPUTER_SCREENSHOT_TTL_SECONDS=300
# JARVIS_COMPUTER_SCREENSHOT_RETAIN=false

# Bounds on the closed PLAN -> ACT -> OBSERVE -> VERIFY loop.
# JARVIS_COMPUTER_MAX_STEPS=25
# JARVIS_COMPUTER_TASK_TIMEOUT_SECONDS=300

# Permission mode and scopes are NOT configured here. They live on the user
# record and are changed in the Computer panel, because a permission that can
# be granted by editing a file an agent can write is not a permission.
# Defaults: SAFE mode, SCREEN and WINDOW enabled, nothing automatic.
