# JARVIS configuration.
# Copy to `.env` at the repository root and fill in. `.env` is gitignored.
#
# Credentials may live here OR in the OS keychain (service name "jarvis").
# The environment is checked first, so a value here overrides the keychain.
# On Windows the keychain is Credential Manager, DPAPI-bound to your account —
# prefer it for anything long-lived.

# ── credentials ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Shared token the frontend presents to the API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_TOKEN=

# ── optional second provider ─────────────────────────────────────────────────
# OPENAI_API_KEY=
# Point at a local runtime instead (Ollama / llama.cpp / LM Studio / vLLM):
# JARVIS_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# JARVIS_OPENAI_COMPAT_MODELS=["llama3.1"]

# ── server ───────────────────────────────────────────────────────────────────
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=console

# Set false only for local development without a token.
JARVIS_REQUIRE_AUTH=true

# ── model assignment per task class ──────────────────────────────────────────
JARVIS_MODEL_REASONING=claude-opus-5
JARVIS_MODEL_CONVERSATION=claude-sonnet-5
JARVIS_MODEL_FAST=claude-haiku-4-5

# ── Phase 2: memory and knowledge ────────────────────────────────────────────

# Embedding endpoint for semantic retrieval. Anything speaking /v1/embeddings:
# OpenAI, Ollama (http://localhost:11434/v1), LM Studio, llama.cpp, vLLM.
# Without one, retrieval is LEXICAL ONLY — it matches wording, not meaning.
# JARVIS reports which it is; it does not pretend.
# JARVIS_EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=
# JARVIS_EMBEDDING_MODEL=text-embedding-3-small
# JARVIS_EMBEDDING_DIM=1536

# ask  = propose memories and wait for yes/no (default)
# auto = store without asking
# off  = store only what you explicitly ask to be remembered
# JARVIS_MEMORY_CAPTURE_MODE=ask
# JARVIS_MEMORY_MAX_INJECTED=8

# Directories JARVIS may ingest documents from. Empty means none, which is the
# safe default for an endpoint that otherwise reads arbitrary files.
# Uploads through the UI work regardless.
# JARVIS_KNOWLEDGE_ROOTS=["/home/you/Documents/notes"]
